{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "simpleterm",
            "command": "sh \"${extensionPath}/plugins/simpleterm/scripts/agent-hook.sh\" gemini; exit 0",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "simpleterm",
            "command": "sh \"${extensionPath}/plugins/simpleterm/scripts/agent-hook.sh\" gemini; exit 0",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
